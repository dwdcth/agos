# agent_memos runtime config

[general]
data_dir = "~/.memos"
default_scope = "global"
default_privacy = "private"
timezone = "Asia/Shanghai"

[store]
backend = "sqlite"                      # sqlite | postgres (future)
sqlite_path = "~/.memos/memos.db"
wal_mode = true
dict_path = "dict"                      # jieba tokenizer dict directory (for chinese-tokenizer feature)


[llm]
provider = "openai"                     # openai | anthropic | azure_openai | ollama | openrouter
model = "Qwen/Qwen3.6-35B-A3B"
api_base = "http://localhost:8000/v1"    # must include /v1 prefix (OpenAI-compatible API)
api_key = "sk-..."                                                   # 填入你的 API Key
temperature = 0.2
max_tokens = 1200
timeout_seconds = 60
enable_thinking = false                  # true to enable Qwen/DeepSeek thinking mode (reasoning_content)


[embedding]
provider = "remote_http"                # remote_http (OpenAI-compatible /embeddings, 推荐：硅基流动) | builtin | openai
model = "BAAI/bge-m3"
api_base = "https://api.siliconflow.cn/v1"   # must include /v1 prefix
api_key = "sk-..."                       # 填入你的硅基流动 API Key（或环境变量 AGENT_MEMOS_EMBEDDING_API_KEY）
dimensions = 1024                        # bge-m3 输出维度；写入前会校验
batch_size = 32                          # 单次请求文本条数上限（硅基流动 bge-m3 上限 32，超量自动分批）
timeout_seconds = 30                     # 单请求超时

[vector]
backend = "sqlite_vec"                  # sqlite_vec | none
table = "object_embeddings_vec"         # sqlite-vec vec0 虚表（懒创建；record_embeddings JSON 表是事实源）
similarity = "cosine"                   # cosine | dot | l2

[cognition]
auto_rumination = true                  # agent-search 执行后自动进反刍闭环（enqueue 触发 + drain 短周期写回）；
                                        # 夜间长周期走 `agent-memos ruminate`

[logging]
level = "INFO"                          # DEBUG | INFO | WARNING | ERROR
json = true
path = "~/.memos/logs/app.log"

# [prompts]  可选：覆盖内置 system prompt，不填则用默认值
# summary_preamble = "You compress raw memory text into a fixed memory DSL draft..."
# simulation_preamble = "You predict the consequences of an action on a world model..."
# agent_preamble = "Delegate all cognition to the internal agent-search orchestrator..."
